module DBotQuery
  module Commands
    # Summary
    # This subcommand takes a JSON export from Dependabot and returns the number of findings in
    # the file. This command should take an optional “state” parameter so that the only vulnerabilities
    # that are counted are the ones that match its value (e.g. open, fixed, dismissed)
    # Inputs
    # Example commands
    # ● ./your
    # _program summary -f dependabot.json
    # ○ Count of all findings in dependabot.json
    # ● ./your
    # _program summary -f dependabot.json --state dismissed
    # ○ Count of all dismissed findings in dependabot.json
    # ● ./your
    # _program summary -f dependabot.json --state open --severity critical
    # ○ Count of all open critical vulnerabilities
    # Outputs
    # Unset
    # {“count”: $count}
    # Where “$count” represents the count of findings in the JSON file. If --state or --severity are
    # specified, the count should only include the findings whose attributes match.
    class SummaryCommand < CommandBase
      type severity = :low | :medium | :high | :critical
      type state = :open | :fixed | :dismissed

      attr_reader severity: severity?
      attr_reader state: state?

      @severity: severity?
      @state: state?

      def initialize: (state: state?, severity: severity?) -> void
    end
  end
end
